# ---------------------------------------------------------------------------
# Quotex Signal AI — environment template
# Copy to `.env` (auto-loaded by the backend) and adjust. Never commit real secrets.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- signal policy -----------------------------------------------------------
# Minimum confidence required to emit a tradable signal (85 = production floor).
MIN_CONFIDENCE=85
# Expiry in minutes (1–5). M1 engine is designed around 1.
EXPIRY_MINUTES=1
# PAPER (records paper trades) | SIGNAL_ONLY (dashboard only). LIVE is not implemented.
TRADING_MODE=PAPER
# auto | live_only | csv | simulated
#   auto      csv → broker feed → public delayed feed → SIMULATED (labelled)
#   live_only no synthetic fallback (signals only when a real feed responds)
DATA_SOURCE_MODE=auto

# --- assets ------------------------------------------------------------------
# Leave empty for the default enabled set. Case-sensitive symbols matter ("-OTCq").
# ENABLED_ASSETS=USDBDT-OTCq,EURCAD-OTCq,EURUSD,GBPUSD
AUTO_SELECT=true
DAILY_SIGNAL_ENABLED=true

# --- scheduler ---------------------------------------------------------------
# Scans every new M1 candle and resolves open signals from verified candles.
SCHEDULER_ENABLED=true

# --- telegram (secrets: environment only, never hard-coded, never via the API) -
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send signals derived from the SIMULATED demo feed (off by default).
TELEGRAM_ALLOW_SIMULATED=false
TELEGRAM_TIMEOUT=8

# --- LIVE FEED (operator-authorised M1 source; see LIVE_FEED_SETUP.md) ---------
# Quotex publishes no public market-data API, and this project invents no feed and
# guesses no credentials. Supply the endpoint and the session value of the source you
# are authorised to use. tools/start_live_feed.py holds the connection, parses the
# messages, builds closed M1 candles and delivers them to the API / rolling store.
#
# STEP 1 — endpoint + session (required; empty = LIVE FEED NOT_CONFIGURED):
#   Example:  QUOTEX_WS_URL=wss://your-feed-host.example.com/stream
#             QUOTEX_SSID=your-session-value
QUOTEX_WS_URL=
QUOTEX_SSID=
#
# STEP 2 — how your feed authenticates and what it streams (optional):
#   Header that carries QUOTEX_SSID (default Authorization), its value prefix, or send
#   the session inside the subscribe message instead.
# LIVE_FEED_AUTH_HEADER=Authorization
# LIVE_FEED_AUTH_SCHEME=Bearer
# LIVE_FEED_AUTH_IN_MESSAGE=false
#   JSON subscribe message, with {asset} and/or {ssid}:
# LIVE_FEED_SUBSCRIBE_TEMPLATE={"action":"subscribe","asset":"{asset}","ssid":"{ssid}"}
#
# STEP 3 — what to bridge (default: the enabled assets, OTC pairs excluded):
# LIVE_FEED_ASSETS=USDJPY,USDCHF
# LIVE_FEED_INCLUDE_OTC=false
#   Feed symbol → known asset, when your feed names instruments differently:
# LIVE_FEED_SYMBOL_MAP=US30=US30,XAU/USD=XAUUSD
#
# STEP 4 — delivery + logging:
# LIVE_FEED_TARGET=api
# LIVE_FEED_API_URL=http://127.0.0.1:8000
# LIVE_FEED_PROVIDER_LABEL=operator_bridge
# LIVE_FEED_CONNECT_TIMEOUT=10
# LIVE_FEED_RECV_TIMEOUT=5
# LIVE_FEED_LOG_SECONDS=30
# LIVE_FEED_MAX_SECONDS=0
# LIVE_FEED_RETENTION_MINUTES=10080
#
# Verify, then run:
#   python3 tools/probe_live_feed.py                # NOT_CONFIGURED | AUTH_FAILED | NO_DATA |
#                                                   # INVALID_DATA | CONNECTED
#   python3 tools/probe_live_feed.py --self-test    # plumbing check, labelled fixture messages
#   python3 tools/start_live_feed.py                # the bridge itself
#   curl http://127.0.0.1:8000/api/data/live-status # FRESH when the bridge is working

# --- TWELVE DATA — realtime STANDARD FX (see LIVE_FEED_SETUP.md, section "Twelve Data") ---
# Twelve Data publishes a public realtime WebSocket for standard FX instruments. The
# bridge (tools/start_twelve_data_feed.py) holds the connection and runs the *same*
# pipeline as every other feed: parse → validate → ContinuousFeed (closed M1 only) →
# rolling store → live_store → the same SignalEngine. No second M1 builder, no second
# engine, no OTC substitution and no simulated fallback.
#
# SECURITY: the key is read from this environment variable only. It is never hard-coded,
# never committed, never written to SQLite or the config table, never returned by the API
# and never printed — every log line and error passes through the shared redactor, which
# masks `apikey=` and every query string.
#
# STEP 1 — your API key (empty = TWELVE DATA NOT CONFIGURED; nothing is invented):
#   TWELVE_DATA_API_KEY=your-twelve-data-api-key
TWELVE_DATA_API_KEY=
#
# STEP 2 — endpoint + instruments (defaults shown; they are correct for Twelve Data):
TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
TWELVE_DATA_SYMBOLS=EUR/USD,GBP/USD,USD/JPY,USD/CHF,AUD/USD
# Instrument → project asset is an explicit map (EUR/USD→EURUSD, GBP/USD→GBPUSD,
# USD/JPY→USDJPY, USD/CHF→USDCHF, AUD/USD→AUDUSD). An instrument that is not in it is
# reported as unmapped and is never subscribed — nothing is guessed.
#
# OTC: USDBDT-OTCq and EURCAD-OTCq are broker-internal instruments. Twelve Data carries
# neither, so they stay DATA UNAVAILABLE. Standard FX is never substituted for an OTC
# pair, and OTC data is never simulated here.
#
# Verify, then run (the key must also be set in the API process for --target api):
#   python3 tools/probe_live_feed.py --provider twelve_data   # NOT_CONFIGURED | AUTH_FAILED
#                                                             # | NO_DATA | INVALID_DATA | CONNECTED
#   python3 tools/probe_live_feed.py --provider twelve_data --self-test
#   python3 tools/start_twelve_data_feed.py --show-config      # resolved config, key redacted
#   python3 tools/start_twelve_data_feed.py                    # the bridge itself
#   curl http://127.0.0.1:8000/api/data/live-status            # FRESH once a closed M1 lands

# --- continuous M1 ingestion + paper collection (phase 2) ---------------------
# Start the continuous feed + automatic per-candle paper scanner with the API.
#   false (default) the API serves signals on request only
#   true            the scanner evaluates every newly closed M1 candle with the SAME
#                   engine the GENERATE SIGNAL button uses
ENABLE_INGESTION=false
# external = only a real provider feed may write candles (never invents one)
# simulated = a clearly-labelled lab feed, development only, can never back a production signal
INGESTION_MODE=external
# Record every scan (qualified and rejected) so the evidence tracker has raw material.
PAPER_COLLECTION=false
INGESTION_TICK_SECONDS=1.0

# --- controlled retraining (never on every candle) ---------------------------
RETRAIN_INTERVAL_DAYS=7
RETRAIN_MIN_NEW_ROWS=2000
RETRAIN_MIN_IMPROVEMENT=0.0

# --- storage ------------------------------------------------------------------
# SQLite file for signals / scans / config. Default: backend/database/signals.db
# SIGNAL_DB_PATH=/absolute/path/to/signals.db

# --- web ----------------------------------------------------------------------
# Comma-separated CORS origins for the API (default: *). The Next.js dev server
# proxies /api/* server-side, so the browser never needs a cross-origin call.
ALLOWED_ORIGINS=*

# --- policy guards (final master phase) ---------------------------------------
# production = signals require a real, fresh feed AND a READY_MARKET artifact.
# development = labelled SIMULATED feeds may exercise the pipeline (never production).
TRADING_ENV=production
# Explicit hard requirements on the feed and the model (both true in production).
REQUIRE_REAL_DATA=true
REQUIRE_MARKET_MODEL=true
# Minimum ensemble agreement for a signal (0.60 = the published floor).
MIN_MODEL_AGREEMENT=0.60
# Assets a controlled retrain trains on (default: the enabled assets).
# RETRAIN_ASSETS=USDJPY,USDCHF

# --- web / API ----------------------------------------------------------------
# Allow the sandbox preview host pattern (https://<port>-<id>.e2b.app) past CORS.
ALLOW_PREVIEW_ORIGINS=true
# Serve /docs, /redoc, /openapi.json (set false to switch them off).
ENABLE_API_DOCS=true

# --- telegram (optional) ------------------------------------------------------
# Credentials come from the environment only; the token is redacted from every error.
# ENABLE_TELEGRAM=true
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
# Override only for a self-hosted Bot API mock (tests use a stub transport).
# TELEGRAM_API_BASE=https://api.telegram.org
